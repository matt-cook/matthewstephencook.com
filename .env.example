# Copy this file to .env.local for local settings. None of these are secrets.
# Default local URL: http://localhost:5173
BASE_PATH=/
SITE_URL=https://matthewstephencook.com

# GitHub repository containing THIS project, e.g. matt-cook/portfolio.
CMS_REPOSITORY=YOUR_GITHUB_USERNAME/YOUR_REPOSITORY
CMS_BRANCH=main

# The origin of a Decap-compatible GitHub OAuth service. See README.md.
# No client secret or access token belongs in the website or these variables.
CMS_AUTH_BASE_URL=
CMS_AUTH_ENDPOINT=auth

# Optional. Set only when ready to use your own domain on GitHub Pages.
CUSTOM_DOMAIN=
